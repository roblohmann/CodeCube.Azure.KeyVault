<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Rob Lohmann</Authors>
    <Description>A straight-forward an simple wrapper around Azure Key Vault.</Description>
    <Copyright>Copyright 2019 - 2026 Rob Lohmann</Copyright>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.Azure.KeyVault</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.Azure.KeyVault</RepositoryUrl>
    <PackageTags>azure keyvault</PackageTags>
    <PackageIconUrl>https://github.com/roblohmann/CodeCube.Azure.KeyVault/blob/master/nuget-icon.png?raw=true</PackageIconUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.KeyVault" />
    <PackageReference Include="Microsoft.Azure.Services.AppAuthentication" />
    <!-- Direct references to override vulnerable transitive versions pulled in by the legacy Azure SDK packages above -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Text.RegularExpressions" />
    <PackageReference Include="Microsoft.Rest.ClientRuntime" />
  </ItemGroup>

</Project>
